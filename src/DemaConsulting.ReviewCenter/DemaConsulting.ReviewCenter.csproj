<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- ReviewCenter is distributed as self-contained single-file executables (see the CI workflow), never as a
         NuGet package. The self-contained and single-file settings are deliberately passed to 'dotnet publish'
         only: setting a runtime identifier here would move the build output folder that the tests and Puppet use. -->
    <IsPackable>false</IsPackable>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>

    <!-- Product Metadata -->
    <Version>0.0.0</Version>
    <Company>DEMA Consulting</Company>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>ReviewCenter</Title>
    <Product>DemaConsulting.ReviewCenter</Product>
    <RepositoryUrl>https://github.com/demaconsulting/ReviewCenter</RepositoryUrl>

    <!-- Source Link Configuration -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Runtime Dependencies -->
  <ItemGroup>
    <PackageReference Include="DemaConsulting.TestResults" Version="1.10.0" />
    <!-- Entity Framework Core with the SQLite provider stores projects and reviews. The native SQLite library
         (e_sqlite3 / libe_sqlite3.so) is published as a side file next to the single-file executable. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <!-- System.Security.Cryptography.Pkcs builds the detached CMS signature (adbe.pkcs7.detached) of the PDF
         attestation. It has no reference assembly in the shared framework, so the package is needed to compile. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- YamlDotNet reads the review-sets of a repository's .reviewmark.yaml (the same library ReviewMark uses). -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <!-- Core holds the framework-free domain; it is bundled into the executable when publishing -->
    <ProjectReference Include="..\DemaConsulting.ReviewCenter.Core\DemaConsulting.ReviewCenter.Core.csproj" />
  </ItemGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
    <PackageReference Include="Polyfill" Version="11.4.5" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in projects that consume this one.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.ReviewCenter.Tests" />
  </ItemGroup>

</Project>
