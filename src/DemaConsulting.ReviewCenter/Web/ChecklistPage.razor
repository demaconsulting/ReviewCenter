@* ChecklistPage: the checklist of one review at "/projects/{id}/reviews/{reviewId}/checklist".

   Presentation only; state and event handling live in ChecklistPage.razor.cs. From the top it shows what is left
   to do (status line, progress, a "Next unanswered check" button), then the sections of the
   checklist with their progress. One section is open at a time (the first with unanswered checks to begin with);
   it offers the "applies to this review" switch (with a required reason when it does not) and one row per check
   with Pass / Fail / N/A buttons. Fail and N/A ask for a justification next to the buttons. When the review is
   concluded (approved or rejected, locked) a notice says so and every control that changes the checklist is disabled and marked
   data-locked="true"; navigation stays available. Every interactive
   element and every key value carries a stable kebab-case data-testid (section and check ids are lower-cased,
   for example "check-pass-req-01"), and the data-interactive marker on the root flips to "true" once the live
   circuit is connected.

   The page body is inside SessionGate, which replaces it with a "Session ended" message when the user is no longer
   valid while the page is open. *@
@page "/projects/{ProjectId:int}/reviews/{ReviewId}/checklist"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Checklist - @(Review?.Id ?? "Review") - ReviewCenter</PageTitle>

<SessionGate>
<main class="page reading" data-testid="checklist-page" data-interactive="@InteractiveMarker">
    <nav class="breadcrumb">
        <a href="/projects" data-testid="breadcrumb-projects-link">Projects</a>
        <span aria-hidden="true">/</span>
        <a href="/projects/@ProjectId" data-testid="project-link">@(ProjectName ?? $"Project {ProjectId}")</a>
        <span aria-hidden="true">/</span>
        <a href="/projects/@ProjectId/reviews/@ReviewId" data-testid="review-link">@ReviewId</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Checklist</span>
    </nav>

    @if (!Loaded)
    {
        <p class="muted" data-testid="checklist-loading">Loading...</p>
    }
    else if (Review is null)
    {
        <p class="error" role="alert" data-testid="checklist-not-found">Review '@ReviewId' does not exist in project @ProjectId.</p>
    }
    else if (State is null)
    {
        <p class="notice" data-testid="checklist-missing">This review has no checklist.</p>
    }
    else
    {
        <h1>Checklist</h1>
        <p class="muted" data-testid="checklist-review-title">@Review.Title</p>

        @if (ReadOnly)
        {
            <p class="notice" role="status" data-testid="readonly-notice">
                Your access to this project is read-only, so you can read the checklist but not change it.
            </p>
        }

        @if (IsConcluded)
        {
            <p class="notice" role="status" data-testid="checklist-locked">
                This review is concluded (approved or rejected) and locked, so the checklist is read-only. A project
                administrator can reopen the
                review; the signatures are then kept as history and the review must be signed again.
            </p>
        }
        else if (State.AuthorBlocked)
        {
            <p class="notice" role="status" data-testid="author-answer-blocked">
                You created this review, so you cannot answer its checklist in this project. Another project member has to
                answer it. You can still start, answer and resolve comment threads.
            </p>
        }
        else if (State.NoSlot && !ReadOnly)
        {
            <p class="notice" role="status" data-testid="no-slot-notice">
                @if (Ballots?.CanAssignMe == true)
                {
                    <text>You are not a reviewer of this review yet. Add yourself to answer the checklist.</text>
                }
                else
                {
                    <text>You are not a reviewer of this review, so you cannot answer. Ask for a reviewer slot on the review
                        page to answer the checklist.</text>
                }
            </p>
            @if (Ballots?.CanAssignMe == true)
            {
                <button type="button" data-testid="assign-me" @onclick="AssignMeAsync">Assign me as reviewer</button>
            }

            @if (AssignError is not null)
            {
                <p class="error" role="alert" data-testid="assign-error">@AssignError</p>
            }
        }

        @if (IsMultiSlot)
        {
            <p class="muted" data-testid="ballots-handed-in">@BallotsLine()</p>
            @if (IsMasked)
            {
                <p class="notice masked-note" role="status" data-testid="ballots-hidden-notice">
                    The other reviewers' answers stay hidden until you hand in your own ballot, so everyone decides
                    on their own first. Their names and whether they have handed in stay visible.
                </p>
            }
        }

        @if (State.IsOwnBallot)
        {
            <p class="muted" data-testid="ballot-status">@BallotStatusLine()</p>
            @if (ShowSubmitAndSign)
            {
                <SignConfirm NeedsPassword="@(!CurrentIsExternal)" NeedsCode="@CurrentHasTotp" OnSubmitAndSign="SubmitAndSignAsync" />
                <p class="muted hint">Or hand in your ballot now and sign later.</p>
            }

            @if (CanSubmitBallot)
            {
                <button type="button" class="@(ShowSubmitAndSign ? "secondary" : null)" data-testid="submit-ballot" @onclick="() => SubmitBallotAsync()">Submit ballot</button>
            }

            @if (BallotError is not null)
            {
                <p class="error" role="alert" data-testid="ballot-error">@BallotError</p>
            }

            @if (SignError is not null)
            {
                <p class="error" role="alert" data-testid="sign-error">@SignError <a href="@ReviewAddress" data-testid="sign-error-review-link">Open the review</a></p>
            }

            @if (Warning?.Key == BallotWarningKey)
            {
                <SignatureWarning Slots="Warning.Slots" OnConfirm="ConfirmWarningAsync" OnCancel="CancelWarning" />
            }
        }

        @if (SignNotice is not null)
        {
            <p class="notice" role="status" data-testid="sign-notice">@SignNotice <a href="@ReviewAddress" data-testid="sign-notice-review-link">Open the review</a></p>
        }

        @if (ReauthPending)
        {
            <form method="post" action="/auth/oidc/reauth" data-testid="submit-sign-reauth-form">
                <AntiforgeryToken />
                <input type="hidden" name="projectId" value="@ProjectId" />
                <input type="hidden" name="reviewId" value="@ReviewId" />
                <input type="hidden" name="slotId" value="@State.SlotId" />
                <input type="hidden" name="returnUrl" value="@ReviewAddress" />
                <p class="notice" role="status" data-testid="submit-sign-reauth-hint">
                    Your ballot is in. To sign, confirm it is you: @Oidc.Value.DisplayName asks you to sign in again, then
                    you come back to the review to sign.
                </p>
                <button type="submit" data-testid="submit-sign-reauth">Confirm identity with @Oidc.Value.DisplayName</button>
            </form>
        }

        @* A viewer without a ballot who may not see the others yet gets no standing: it would show answers *@
        @if (!State.IsMasked)
        {
        <section class="card">
            <p class="status" data-testid="checklist-status">@StatusLine()</p>
            <p data-testid="checklist-progress">@ProgressLine()</p>
            @if (!State.IsComplete)
            {
                <button type="button" data-testid="next-unanswered-button" @onclick="() => GuardedAsync(GoToNextUnanswered)">Next unanswered check</button>
            }
            else
            {
                <a class="action outline" href="/projects/@ProjectId/reviews/@ReviewId" data-testid="back-to-review-link">Back to the review</a>
            }
        </section>
        }

        <ul class="checklist-sections">
            @foreach (var section in State.Definition.Sections)
            {
                var sid = TestId(section.Id);
                var sectionId = section.Id;
                var isOpen = OpenSectionId == section.Id;
                var progress = State.SectionProgress(section.Id);
                var applicable = IsApplicableInPage(section.Id);
                <li class="checklist-section" data-testid="section-@sid">
                    <h2 class="section-heading">
                        <button type="button" class="section-toggle" aria-expanded="@(isOpen ? "true" : "false")"
                                data-testid="section-@sid-toggle" @onclick="() => GuardedAsync(() => ToggleSection(sectionId))">
                            <span class="section-title"><span class="section-chevron" aria-hidden="true">@(isOpen ? "\u25BE" : "\u25B8")</span>@section.Title</span>
                            @if (!State.IsMasked)
                            {
                                <span class="badge @SectionBadgeClass(section.Id, progress.IsDone)"
                                      data-testid="section-@sid-progress">@SectionProgressLabel(section.Id)</span>
                            }
                        </button>
                    </h2>
                    @if (State.CarriedFromFor(section.Id) is { } carriedSection)
                    {
                        <p class="muted hint" data-testid="section-@sid-carried">
                            Not applicable, carried from review <a href="@ReviewLinks.ForReview(ProjectId, carriedSection)" data-testid="section-@sid-carried-link">@carriedSection</a>
                        </p>
                    }

                    @if (isOpen)
                    {
                        <div class="section-body">
                            <label class="switch" for="applicable-@sid">
                                <input id="applicable-@sid" type="checkbox" checked="@(applicable || IsSwitchOnWaiting(section.Id))"
                                       data-testid="section-@sid-applicable" disabled="@ControlsDisabled" data-locked="@LockedMarker"
                                       @onchange="e => SetApplicableAsync(sectionId, (bool)(e.Value ?? false))" />
                                This section applies to the review
                            </label>

                            @if (!applicable)
                            {
                                <p class="muted hint">@section.ApplicabilityHint</p>
                                @if (PendingNotApplicable.Contains(section.Id))
                                {
                                    <p class="muted hint" data-testid="section-@sid-unsaved-hint">Not saved until you press Save reason.</p>
                                }
                                <div class="field">
                                    <label for="reason-@sid">Reason it does not apply <span class="required">* required</span></label>
                                    <textarea id="reason-@sid" rows="2" maxlength="@ReviewLimits.MaxJustificationLength"
                                              data-testid="section-@sid-reason" disabled="@ControlsDisabled" value="@ReasonText(section.Id)"
                                              @oninput="e => ReasonTexts[sectionId] = e.Value?.ToString() ?? string.Empty"></textarea>
                                </div>
                                <button type="button" disabled="@ControlsDisabled" data-testid="section-@sid-save" @onclick="() => SaveNotApplicableAsync(sectionId)">Save reason</button>
                                @if (SectionErrors.TryGetValue(section.Id, out var sectionError))
                                {
                                    <p class="error" role="alert" data-testid="section-@sid-error">@sectionError</p>
                                }
                                @if (SectionWarningFor(sectionId) is { } sectionWarning)
                                {
                                    <SignatureWarning Slots="sectionWarning.Slots" OnConfirm="ConfirmWarningAsync" OnCancel="CancelWarning" />
                                }
                            }
                            else
                            {
                                @if (SectionErrors.TryGetValue(section.Id, out var applicableError))
                                {
                                    <p class="error" role="alert" data-testid="section-@sid-error">@applicableError</p>
                                }
                                <ul class="checks">
                                    @foreach (var item in section.Items)
                                    {
                                        var iid = TestId(item.Id);
                                        var itemId = item.Id;
                                        var answer = State.AnswerFor(item.Id);
                                        var shown = ShownOutcome(item.Id);
                                        var needsJustification = shown is ChecklistOutcome.Fail or ChecklistOutcome.NotApplicable;
                                        <li class="check-row @(answer is null ? "unanswered" : null)" data-testid="check-@iid">
                                            <p class="check-text" id="check-text-@iid"><span class="check-id">@item.Id</span> @item.Text</p>
                                            @if (answer?.CarriedFromReviewId is { } carriedFrom)
                                            {
                                                <p class="muted hint" data-testid="check-carried-@iid">
                                                    <span class="badge">Carried from</span>
                                                    <a href="@ReviewLinks.ForReview(ProjectId, carriedFrom)" data-testid="check-carried-link-@iid">@carriedFrom</a>
                                                </p>
                                            }
                                            else if (EarlierFailFor(item) is { } earlierFail)
                                            {
                                                <p class="notice" data-testid="check-earlier-fail-@iid">
                                                    Failed in review <a href="@ReviewLinks.ForReview(ProjectId, Review!.FollowsReviewId!)" data-testid="check-earlier-fail-link-@iid">@(Review.FollowsReviewId)</a>:
                                                    @earlierFail.Justification
                                                    Decide this check again.
                                                </p>
                                            }
                                            <div class="segmented" role="group" aria-labelledby="check-text-@iid">
                                                <button type="button" class="secondary" aria-pressed="@PressedValue(shown, ChecklistOutcome.Pass)"
                                                        data-testid="check-pass-@iid" disabled="@ControlsDisabled" data-locked="@LockedMarker" @onclick="() => ChooseAsync(itemId, ChecklistOutcome.Pass)">Pass</button>
                                                <button type="button" class="secondary fail" aria-pressed="@PressedValue(shown, ChecklistOutcome.Fail)"
                                                        data-testid="check-fail-@iid" disabled="@ControlsDisabled" data-locked="@LockedMarker" @onclick="() => ChooseAsync(itemId, ChecklistOutcome.Fail)">Fail</button>
                                                <button type="button" class="secondary" aria-pressed="@PressedValue(shown, ChecklistOutcome.NotApplicable)"
                                                        data-testid="check-na-@iid" disabled="@ControlsDisabled" data-locked="@LockedMarker" @onclick="() => ChooseAsync(itemId, ChecklistOutcome.NotApplicable)">N/A</button>
                                            </div>

                                            @if (needsJustification)
                                            {
                                                <div class="field">
                                                    <label for="justification-@iid">Justification <span class="required">* required for Fail and N/A</span></label>
                                                    <textarea id="justification-@iid" rows="2" maxlength="@ReviewLimits.MaxJustificationLength"
                                                              data-testid="check-justification-@iid" disabled="@ControlsDisabled" value="@JustificationText(item.Id)"
                                                              @oninput="e => JustificationTexts[itemId] = e.Value?.ToString() ?? string.Empty"></textarea>
                                                </div>
                                                <button type="button" disabled="@ControlsDisabled" data-testid="check-save-@iid" @onclick="() => SaveAsync(itemId)">Save</button>
                                                @if (IsUnsaved(item.Id))
                                                {
                                                    <span class="muted hint">Not saved yet.</span>
                                                }
                                            }

                                            @if (ItemErrors.TryGetValue(item.Id, out var itemError))
                                            {
                                                <p class="error" role="alert" data-testid="check-error-@iid">@itemError</p>
                                            }

                                            @if (Warning?.Key == ItemWarningKey(item.Id))
                                            {
                                                <SignatureWarning Slots="Warning.Slots" OnConfirm="ConfirmWarningAsync" OnCancel="CancelWarning" />
                                            }

                                            @if (answer is not null)
                                            {
                                                <p class="muted hint" data-testid="check-answered-by-@iid">Answered by @answer.AnsweredBy, @FormatTime(answer.AnsweredAt)</p>
                                            }

                                            @if (Ballots?.Differing.TryGetValue(item.Id, out var differing) == true)
                                            {
                                                <p class="ballot-others ballot-disagree" data-testid="ballot-others-@iid">
                                                    <span class="badge"><span aria-hidden="true">&#9888; </span>Different answers</span>
                                                    <span data-testid="ballot-others-text-@iid">@SideBySide(differing)</span>
                                                </p>
                                                @if (Capabilities.CanStartCheckThread && !DiscussOpen.Contains(item.Id))
                                                {
                                                    <button type="button" class="secondary" data-testid="discuss-@iid"
                                                            @onclick="() => ToggleDiscuss(itemId)">Discuss</button>
                                                }
                                            }

                                            @if (DiscussOpen.Contains(item.Id))
                                            {
                                                <div class="field" data-testid="discuss-form-@iid">
                                                    <label for="discuss-text-@iid">What do you want to talk about?</label>
                                                    <textarea id="discuss-text-@iid" rows="2" maxlength="@ReviewLimits.MaxCommentLength"
                                                              data-testid="discuss-text-@iid" value="@DiscussTexts.GetValueOrDefault(item.Id)"
                                                              @oninput="e => DiscussTexts[itemId] = e.Value?.ToString() ?? string.Empty"></textarea>
                                                </div>
                                                <div class="form-actions">
                                                    <button type="button" data-testid="discuss-start-@iid" @onclick="() => StartDiscussionAsync(itemId)">Start discussion</button>
                                                    <button type="button" class="secondary" data-testid="discuss-cancel-@iid" @onclick="() => ToggleDiscuss(itemId)">Cancel</button>
                                                </div>
                                            }

                                            @if (DiscussErrors.TryGetValue(item.Id, out var discussError))
                                            {
                                                <p class="error" role="alert" data-testid="discuss-error-@iid">@discussError</p>
                                            }

                                            @if (Warning?.Key == DiscussWarningKey(item.Id))
                                            {
                                                <SignatureWarning Slots="Warning.Slots" OnConfirm="ConfirmWarningAsync" OnCancel="CancelWarning" />
                                            }

                                            @if (DiscussStarted.Contains(item.Id))
                                            {
                                                <p class="notice" role="status" data-testid="discuss-started-@iid">
                                                    Discussion started. Find it on <a href="@ReviewAddress">the review page</a>.
                                                </p>
                                            }
                                        </li>
                                    }
                                </ul>
                            }

                            @if (progress.IsDone && !PendingNotApplicable.Contains(section.Id))
                            {
                                @* The section is finished: say what comes next, here where the reviewer is looking *@
                                @if (State.IsComplete)
                                {
                                    <p class="section-next"><a class="action outline" href="/projects/@ProjectId/reviews/@ReviewId" data-testid="section-@sid-back">Back to the review</a></p>
                                }
                                else
                                {
                                    <p class="section-next"><button type="button" data-testid="section-@sid-next" @onclick="() => GuardedAsync(GoToNextUnanswered)">Next unanswered check</button></p>
                                }
                            }
                        </div>
                    }
                </li>
            }
        </ul>
    }
</main>
</SessionGate>
