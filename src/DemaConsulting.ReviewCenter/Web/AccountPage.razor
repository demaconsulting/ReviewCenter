@* AccountPage: lets the signed-in user change their own password, at "/account".

   Presentation only; state and event handling live in AccountPage.razor.cs. Every interactive element and
   every key value carries a stable kebab-case data-testid, and the data-interactive marker on the root flips
   to "true" once the live circuit is connected.

   The page body is inside SessionGate, which replaces it with a "Session ended" message when the user is no longer
   valid while the page is open. A user who still has a temporary password (set by the person who created the
   account) sees only a banner and the change-password form; after the change the user is sent to the login page to
   sign in again with the new password. A user of an identity provider has no password: the change-password card is
   replaced by a sentence that says who manages it. *@
@page "/account"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Account - ReviewCenter</PageTitle>

<SessionGate>
<main class="page narrow" data-testid="account-page" data-interactive="@InteractiveMarker">
    <h1>Account</h1>

    @if (MustChangePassword)
    {
        <p class="notice" role="status" data-testid="password-change-required-banner">
            Your password is temporary. Choose a new password to continue.
        </p>
    }
    else
    {
    <section class="card" data-testid="appearance-card">
        <h2 id="appearance-heading">Appearance</h2>
        <p class="muted hint">Remembered in this browser only. System follows your device setting.</p>
        <div class="option-cards three" role="radiogroup" aria-labelledby="appearance-heading">
            <label class="option-card">
                <input type="radio" name="theme" value="system" data-testid="theme-system"
                       checked="@(Theme == "system")" @onchange="@(() => SelectThemeAsync("system"))" />
                <span class="option-title">System</span>
                <span class="option-text">Match my device.</span>
            </label>
            <label class="option-card">
                <input type="radio" name="theme" value="light" data-testid="theme-light"
                       checked="@(Theme == "light")" @onchange="@(() => SelectThemeAsync("light"))" />
                <span class="option-title">Light</span>
                <span class="option-text">Dark text on a light background.</span>
            </label>
            <label class="option-card">
                <input type="radio" name="theme" value="dark" data-testid="theme-dark"
                       checked="@(Theme == "dark")" @onchange="@(() => SelectThemeAsync("dark"))" />
                <span class="option-title">Dark</span>
                <span class="option-text">Light text on a dark background.</span>
            </label>
        </div>
    </section>
    }

    <section class="card">
        <h2>Change password</h2>
        @if (IsExternal)
        {
            <p class="muted" data-testid="account-external-password">
                Your password is managed by @Oidc.Value.DisplayName. There is no password to change here.
            </p>
        }
        else
        {
        <form data-testid="change-password-form" @onsubmit="ChangePasswordAsync">
            <div class="field">
                <label for="current-password">@(MustChangePassword ? "Temporary password" : "Current password")</label>
                <input id="current-password" type="password" autocomplete="current-password"
                       data-testid="current-password-input" @bind="CurrentPassword" @bind:event="oninput" />
            </div>
            <div class="field">
                <label for="new-password">New password</label>
                <input id="new-password" type="password" autocomplete="new-password"
                       maxlength="@ReviewLimits.MaxPasswordLength"
                       data-testid="new-password-input" @bind="NewPassword" @bind:event="oninput" />
                <p class="muted hint">At least @ReviewLimits.MinPasswordLength characters.</p>
            </div>
            <div class="field">
                <label for="confirm-password">Repeat the new password</label>
                <input id="confirm-password" type="password" autocomplete="new-password"
                       maxlength="@ReviewLimits.MaxPasswordLength"
                       data-testid="confirm-password-input" @bind="ConfirmPassword" @bind:event="oninput" />
            </div>
            @if (ErrorMessage is not null)
            {
                <p class="error" role="alert" data-testid="account-error">@ErrorMessage</p>
            }
            @if (Message is not null)
            {
                <p class="notice" data-testid="account-message">@Message</p>
            }
            <button type="submit" data-testid="change-password-button">Change password</button>
        </form>
        }
    </section>

    @if (!MustChangePassword)
    {
    @if (Totp.FeatureEnabled && (IsExternal || TotpInfo is { Available: true }))
    {
    <section class="card" data-testid="totp-card">
        <h2>Two-factor authentication</h2>
        @if (IsExternal)
        {
            <p class="muted" data-testid="totp-external">
                Two-factor sign-in is handled by @Oidc.Value.DisplayName.
            </p>
        }
        else
        {
        <p class="muted hint">
            Ask for a code from an authenticator app when you sign in and when you sign a review.
            <a href="/help/two-factor" data-testid="totp-help-link">About two-factor authentication</a>
        </p>
        <p>
            Two-factor sign-in is
            <span class="badge @(TotpInfo!.Enrolled ? "approved" : null)" data-testid="totp-status">@(TotpInfo.Enrolled ? "On" : "Off")</span>
            @if (TotpInfo.Enrolled)
            {
                <span class="muted totp-left" data-testid="totp-recovery-left">@RecoveryLeftText</span>
            }
        </p>

        @if (NewRecoveryCodes is not null)
        {
            <div class="notice" role="status" data-testid="totp-recovery-box">
                <p><strong>Save these recovery codes now. They cannot be shown again.</strong></p>
                <p>Each code works once if you lose your authenticator. Keep them somewhere safe, apart from your password.</p>
                <ul class="recovery-codes" data-testid="totp-recovery-codes">
                    @for (var i = 0; i < NewRecoveryCodes.Count; i++)
                    {
                        <li><code class="mono" data-testid="totp-recovery-code-@i">@NewRecoveryCodes[i]</code></li>
                    }
                </ul>
                <p>
                    <button type="button" class="outline small" data-testid="totp-recovery-copy"
                            @onclick="CopyRecoveryCodesAsync">Copy</button>
                    <button type="button" class="outline small" data-testid="totp-recovery-dismiss"
                            @onclick="DismissRecoveryCodes">I have saved them</button>
                    <span class="muted" role="status" data-testid="totp-copy-status">@TotpCopyStatus</span>
                </p>
            </div>
        }

        @if (TotpError is not null)
        {
            <p class="error" role="alert" data-testid="totp-error">@TotpError</p>
        }
        @if (TotpMessage is not null)
        {
            <p class="notice" role="status" data-testid="totp-message">@TotpMessage</p>
        }

        @if (TotpInfo.Enrolled)
        {
            <details data-testid="totp-regen-details">
                <summary>Get new recovery codes</summary>
                <form data-testid="totp-regen-form" @onsubmit="RegenerateRecoveryCodesAsync">
                    <p class="muted hint">The old codes stop working.</p>
                    <div class="field">
                        <label for="totp-regen-password">Your password</label>
                        <input id="totp-regen-password" type="password" autocomplete="current-password"
                               maxlength="@ReviewLimits.MaxPasswordLength"
                               data-testid="totp-regen-password" @bind="TotpRegenPassword" @bind:event="oninput" />
                    </div>
                    <div class="field">
                        <label for="totp-regen-code">Current code from your authenticator app</label>
                        <input id="totp-regen-code" type="text" inputmode="numeric" maxlength="6" autocomplete="one-time-code"
                               data-testid="totp-regen-code" @bind="TotpRegenCode" @bind:event="oninput" />
                    </div>
                    <button type="submit" class="outline" data-testid="totp-regen-button">Get new recovery codes</button>
                </form>
            </details>
            <details data-testid="totp-disable-details">
                <summary>Turn off two-factor sign-in</summary>
                <form data-testid="totp-disable-form" @onsubmit="DisableTotpAsync">
                    <div class="field">
                        <label for="totp-disable-password">Your password</label>
                        <input id="totp-disable-password" type="password" autocomplete="current-password"
                               maxlength="@ReviewLimits.MaxPasswordLength"
                               data-testid="totp-disable-password" @bind="TotpDisablePassword" @bind:event="oninput" />
                    </div>
                    <div class="field">
                        <label for="totp-disable-code">Current code, or a recovery code</label>
                        <input id="totp-disable-code" type="text" maxlength="24" autocomplete="one-time-code"
                               autocapitalize="characters" spellcheck="false"
                               data-testid="totp-disable-code" @bind="TotpDisableCode" @bind:event="oninput" />
                    </div>
                    <button type="submit" class="outline" data-testid="totp-disable-button">Turn off</button>
                </form>
            </details>
        }
        else if (PendingEnrollment is not null)
        {
            <div data-testid="totp-pending">
                <p><strong>1.</strong> In your authenticator app, add an account with this key.</p>
                <p><code class="mono totp-secret" data-testid="totp-secret">@GroupedSecret</code></p>
                <p class="muted hint">Apps that accept an address can use this one instead:</p>
                <p><code class="mono totp-secret" data-testid="totp-uri">@PendingEnrollment.OtpauthUri</code></p>
                <form data-testid="totp-confirm-form" @onsubmit="ConfirmTotpAsync">
                    <div class="field">
                        <label for="totp-confirm-code"><strong>2.</strong> Enter the 6-digit code the app shows now</label>
                        <input id="totp-confirm-code" type="text" inputmode="numeric" maxlength="6" autocomplete="one-time-code"
                               data-testid="totp-confirm-code" @bind="TotpConfirmCode" @bind:event="oninput" />
                    </div>
                    <button type="submit" data-testid="totp-confirm-button">Turn on</button>
                    <button type="button" class="outline" data-testid="totp-cancel-button"
                            @onclick="CancelTotpAsync">Cancel</button>
                </form>
            </div>
        }
        else
        {
            <form data-testid="totp-start-form" @onsubmit="StartTotpAsync">
                <div class="field">
                    <label for="totp-start-password">Your password</label>
                    <input id="totp-start-password" type="password" autocomplete="current-password"
                           maxlength="@ReviewLimits.MaxPasswordLength"
                           data-testid="totp-start-password" @bind="TotpStartPassword" @bind:event="oninput" />
                </div>
                <button type="submit" data-testid="totp-start-button">Set up two-factor sign-in</button>
            </form>
        }
        }
    </section>
    }

    <section class="card" data-testid="tokens-card">
        <h2 id="tokens-heading">API tokens</h2>
        <p class="muted hint">A token lets a script or tool use the ReviewCenter API as you. It can read projects and reviews and create review drafts; it can never sign. The token is shown once, so copy it right away.</p>
        <p><a class="action outline small" href="/help/api-tokens" data-testid="tokens-help-link">About API tokens</a></p>
        <form data-testid="create-token-form" @onsubmit="CreateTokenAsync">
            <div class="field">
                <label for="token-name">What is the token for?</label>
                <input id="token-name" type="text" autocomplete="off"
                       maxlength="@ReviewLimits.MaxTokenNameLength"
                       data-testid="token-name-input" @bind="TokenName" @bind:event="oninput" />
            </div>
            <p id="token-expiry-heading" class="muted hint">Expires after</p>
            <div class="option-cards three" role="radiogroup" aria-labelledby="token-expiry-heading">
                @foreach (var days in ReviewLimits.TokenExpiryChoicesInDays)
                {
                    var choice = days;
                    <label class="option-card">
                        <input type="radio" name="token-expiry" value="@choice" data-testid="token-expiry-@choice"
                               checked="@(TokenExpiryDays == choice)" @onchange="@(() => TokenExpiryDays = choice)" />
                        <span class="option-title">@choice days</span>
                    </label>
                }
            </div>
            @if (TokenError is not null)
            {
                <p class="error" role="alert" data-testid="token-error">@TokenError</p>
            }
            @if (TokenMessage is not null)
            {
                <p class="notice" role="status" data-testid="token-message">@TokenMessage</p>
            }
            <button type="submit" data-testid="create-token-button">Create token</button>
        </form>

        @if (NewTokenValue is not null)
        {
            <div class="notice" role="status" data-testid="new-token-box">
                <p><strong>Copy this token now. It cannot be shown again.</strong></p>
                <p><code class="mono" data-testid="new-token-value">@NewTokenValue</code></p>
                <p>
                    <button type="button" class="outline small" data-testid="copy-token-button"
                            @onclick="CopyTokenAsync">Copy</button>
                    <button type="button" class="outline small" data-testid="dismiss-token-button"
                            @onclick="DismissToken">Done</button>
                    <span class="muted" role="status" data-testid="token-copy-status">@CopyStatus</span>
                </p>
            </div>
        }

        @if (Tokens.Count == 0)
        {
            <p class="muted" data-testid="token-list-empty">You have no tokens yet.</p>
        }
        else
        {
            <ul class="row-list" data-testid="token-list">
                @foreach (var token in Tokens)
                {
                    var tokenId = token.Id;
                    var status = StatusOf(token);
                    <li class="row-card static-row" data-testid="token-row-@tokenId">
                        <div class="row-main">
                            <strong class="row-title" data-testid="token-name-@tokenId">@token.Name</strong>
                            <p class="muted mono" data-testid="token-display-id-@tokenId">@token.DisplayId</p>
                            <p class="row-badges">
                                <span class="badge @(status == "Active" ? "approved" : null)" data-testid="token-status-@tokenId">@status</span>
                                <span class="muted" data-testid="token-created-@tokenId">Created @FormatDate(token.Created)</span>
                                <span class="muted" data-testid="token-expires-@tokenId">Expires @FormatDate(token.Expires)</span>
                                <span class="muted" data-testid="token-last-used-@tokenId">Last used @(token.LastUsed is { } lastUsed ? FormatDate(lastUsed) : "never")</span>
                            </p>
                        </div>
                        @if (status == "Active")
                        {
                            <div class="row-actions">
                                <button type="button" class="outline small" data-testid="revoke-token-@tokenId"
                                        @onclick="() => RevokeTokenAsync(tokenId)">Revoke</button>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </section>
    }
</main>
</SessionGate>
