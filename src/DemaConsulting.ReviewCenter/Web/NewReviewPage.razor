@* NewReviewPage: the form that creates a review, at "/projects/{id}/reviews/new". The page holds only the form (a
   narrow column); Cancel goes back to the project and a successful creation opens the new review. The files come
   from an upload or from a git repository, chosen with two option cards.

   Presentation only; state and event handling live in NewReviewPage.razor.cs. Every interactive element carries a
   stable kebab-case data-testid, and the data-interactive marker on the root flips to "true" once the live circuit is
   connected. Only the repositories of this project are offered, and a project the user may not see looks like a
   project that does not exist.

   Human factors: (a) the two sources are two cards, so the choice is visible at once; (b) only the fields of the
   chosen source are shown; (c) with no repository, the upload card stays usable and a hint says who can add one.

   The page body is inside SessionGate, which replaces it with a "Session ended" message when the user is no longer
   valid while the page is open. *@
@page "/projects/{ProjectId:int}/reviews/new"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>New review - ReviewCenter</PageTitle>

<SessionGate>
<main class="page narrow" data-testid="new-review-page" data-interactive="@InteractiveMarker">
    <nav class="breadcrumb">
        <a href="/projects" data-testid="breadcrumb-projects-link">Projects</a>
        <span aria-hidden="true">/</span>
        <a href="/projects/@ProjectId" data-testid="project-link">@(Project?.Name ?? $"Project {ProjectId}")</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">New review</span>
    </nav>

    @if (!Loaded)
    {
        <p class="muted" data-testid="project-loading">Loading...</p>
    }
    else if (Project is null)
    {
        <p class="error" role="alert" data-testid="project-not-found">Project @ProjectId does not exist.</p>
    }
    else
    {
        <h1>New review</h1>
        @if (!CanContribute)
        {
            <p class="notice" role="status" data-testid="readonly-notice">
                Your access to this project is read-only, so you cannot create reviews.
            </p>
        }
        else
        {
        <p class="page-lead">Choose the files to review: upload them, or read them from a registered git repository.</p>

        <section class="card">
            <form data-testid="new-review-form" @onsubmit="CreateReviewAsync">
                <div class="field">
                    <label for="review-id">Review id</label>
                    <input id="review-id" type="text" maxlength="@ReviewLimits.MaxReviewIdLength"
                           data-testid="review-id-input" @bind="ReviewId" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label for="review-title">Title</label>
                    <input id="review-title" type="text" maxlength="@ReviewLimits.MaxReviewTitleLength"
                           data-testid="review-title-input" @bind="ReviewTitle" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label for="review-due-date">Due date (optional)</label>
                    <input id="review-due-date" type="date" data-testid="due-date-input" value="@DueDateText"
                           @oninput="e => DueDateText = e.Value?.ToString() ?? string.Empty" />
                    <span class="muted">A calendar day in UTC, from today up to two years ahead.</span>
                </div>
                <fieldset class="field source-choice" data-testid="review-source">
                    <legend>Files come from</legend>
                    <div class="option-cards">
                        <label class="option-card">
                            <input type="radio" name="review-source" checked="@(!FromRepository)"
                                   data-testid="source-upload-radio" @onchange="() => GuardedAsync(() => ChooseSource(false))" />
                            <span class="option-title">Upload files</span>
                            <span class="option-text">Choose files from your computer.</span>
                        </label>
                        <label class="option-card">
                            <input type="radio" name="review-source" checked="@FromRepository"
                                   disabled="@(Repositories.Count == 0)"
                                   data-testid="source-repository-radio" @onchange="() => GuardedAsync(() => ChooseSource(true))" />
                            <span class="option-title">From a repository</span>
                            <span class="option-text">Compare a revision of a registered git repository.</span>
                        </label>
                    </div>
                    @if (Repositories.Count == 0)
                    {
                        <p class="muted" data-testid="no-repository-hint">This project has no repository; ask a project administrator to add one.</p>
                    }
                </fieldset>
                @if (FromRepository)
                {
                    <div class="field">
                        <label for="review-repository">Repository</label>
                        <select id="review-repository" data-testid="repository-select" @bind="RepositoryIdText">
                            <option value="">Choose a repository</option>
                            @foreach (var repository in Repositories)
                            {
                                <option value="@repository.Id">@repository.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="review-head-revision">Head revision</label>
                        <input id="review-head-revision" type="text" maxlength="@RevisionValidator.MaxLength"
                               autocomplete="off" data-testid="head-revision-input"
                               @bind="HeadRevision" @bind:event="oninput" />
                        <span class="muted">A branch, tag or commit.</span>
                    </div>
                    <div class="field">
                        <label for="review-baseline-revision">Baseline revision (optional)</label>
                        <input id="review-baseline-revision" type="text" maxlength="@RevisionValidator.MaxLength"
                               autocomplete="off" data-testid="baseline-revision-input"
                               @bind="BaselineRevision" @bind:event="oninput" />
                        <span class="muted">Leave empty to review all files at the head.</span>
                    </div>
                    <div class="field">
                        <label for="review-selection">File selection</label>
                        <textarea id="review-selection" rows="3" maxlength="@ReviewLimits.MaxSelectionLength"
                                  data-testid="selection-input" @bind="Selection" @bind:event="oninput"></textarea>
                        <span class="muted">One pattern per line; start a line with ! to exclude.</span>
                    </div>
                }
                else
                {
                    <div class="field">
                        <label for="review-files">Files</label>
                        <InputFile id="review-files" multiple OnChange="OnFilesSelectedAsync" data-testid="review-files-input" />
                    </div>
                    @if (SelectedFiles.Count > 0)
                    {
                        <ul class="item-list" data-testid="selected-files-list">
                            @for (var index = 0; index < SelectedFiles.Count; index++)
                            {
                                <li data-testid="selected-file-@index">
                                    <span class="path" data-testid="selected-file-path-@index">@SelectedFiles[index].Path</span>
                                    <span class="muted" data-testid="selected-file-size-@index">@SelectedFiles[index].Content.Length bytes</span>
                                </li>
                            }
                        </ul>
                    }
                }
                @if (Candidates.Count > 0)
                {
                    var eligible = EligibleCandidates();
                    <div class="field" data-testid="follow-up">
                        <label for="follow-source">Follow up on an earlier review (optional)</label>
                        <select id="follow-source" data-testid="follow-source-select" value="@FollowSourceId"
                                @onchange="OnFollowSourceChangedAsync">
                            <option value="">No, this is a new review</option>
                            @foreach (var candidate in eligible)
                            {
                                <option value="@candidate.Id">@candidate.Id - @candidate.Title</option>
                            }
                        </select>
                        <span class="muted">
                            A follow-up takes over the Pass and N/A answers, the N/A sections and the open threads of the
                            earlier review; Fail answers, resolved threads, reviewer slots and signatures are never carried.
                        </span>
                        @if (eligible.Count == 0)
                        {
                            <p class="muted" data-testid="follow-source-none">
                                @(FromRepository && RepositoryIdText.Length == 0
                                    ? "Choose a repository to see the earlier reviews that can be followed up."
                                    : "No earlier review of this project can be followed up with these files.")
                            </p>
                        }
                        @if (FollowSourceId.Length > 0)
                        {
                            @if (FollowRefusal is not null)
                            {
                                <p class="error" role="alert" data-testid="follow-preview-error">@FollowRefusal</p>
                            }
                            else if (FollowPreview is not null)
                            {
                                <p data-testid="follow-preview">
                                    Carried over from <strong>@FollowSourceId</strong>:
                                    @FollowPreview.CarriedAnswers Pass or N/A @(FollowPreview.CarriedAnswers == 1 ? "answer" : "answers"),
                                    @FollowPreview.CarriedSections N/A @(FollowPreview.CarriedSections == 1 ? "section" : "sections")
                                    and @FollowPreview.CarriedThreads open @(FollowPreview.CarriedThreads == 1 ? "thread" : "threads").
                                    @FollowPreview.ResolvedThreadsNotCarried resolved
                                    @(FollowPreview.ResolvedThreadsNotCarried == 1 ? "thread is" : "threads are") not carried.
                                    @if (FollowPreview.CheckThreadsLeftOut > 0)
                                    {
                                        <text>
                                            @FollowPreview.CheckThreadsLeftOut check
                                            @(FollowPreview.CheckThreadsLeftOut == 1 ? "discussion is" : "discussions are")
                                            not carried.
                                        </text>
                                    }
                                </p>
                            }
                            else
                            {
                                <p class="muted" data-testid="follow-preview-hint">
                                    @(FromRepository
                                        ? "What is carried over is counted when the review is created and shown on its page."
                                        : "Choose the files to see what is carried over.")
                                </p>
                            }

                            @if (FollowPreview is { DroppedThreadFiles.Count: > 0 })
                            {
                                <p class="notice" data-testid="follow-dropped-files">
                                    Open threads on these files are not carried, because the files are not in the new review:
                                    @string.Join(", ", FollowPreview.DroppedThreadFiles)
                                </p>
                            }

                            @if (FromRepository || FollowPreview is { DroppedThreadFiles.Count: > 0 })
                            {
                                <label class="switch" for="follow-acknowledge">
                                    <input id="follow-acknowledge" type="checkbox" checked="@AcknowledgeDropped"
                                           data-testid="follow-acknowledge-checkbox"
                                           @onchange="e => AcknowledgeDropped = (bool)(e.Value ?? false)" />
                                    I have checked the open threads of the earlier review whose files are not in this one
                                </label>
                            }
                        }
                    </div>
                }
                @if (ErrorMessage is not null)
                {
                    <p class="error" role="alert" data-testid="review-error">@ErrorMessage</p>
                }
                <div class="plan-actions">
                    <button type="submit" disabled="@Busy" data-testid="create-review-button">@(Busy ? "Creating review..." : "Create review")</button>
                    <a class="action outline" href="/projects/@ProjectId" data-testid="cancel-new-review-link">Cancel</a>
                </div>
            </form>
            @if (CreatedReview is not null)
            {
                <div role="status" data-testid="review-created">
                    <p>Review <strong>@CreatedReview.Id</strong> was created. These entries were left out because only regular files are reviewed:</p>
                    <ul class="item-list" data-testid="skipped-entries-list">
                        @for (var index = 0; index < SkippedEntries.Count; index++)
                        {
                            <li data-testid="skipped-entry-@index">
                                <span class="path">@SkippedEntries[index].Path</span>
                                <span class="muted">@SkippedEntries[index].Reason</span>
                            </li>
                        }
                    </ul>
                    <a class="action" href="/projects/@ProjectId/reviews/@CreatedReview.Id" data-testid="open-created-review-link">Open the review</a>
                </div>
            }
        </section>
        }
    }
</main>
</SessionGate>
