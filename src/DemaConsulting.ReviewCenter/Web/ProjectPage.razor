@* ProjectPage: one project with its reviews, at "/projects/{id}". The reviews are the whole page: a list of rows (id,
   title, state and approval badges, creation date), each row a link to the review, with a "+ New review" button
   that leads to the separate creation page at "/projects/{id}/reviews/new" and a "Plan reviews" button.

   Presentation only; state lives in ProjectPage.razor.cs. Every interactive element and every key value carries a
   stable kebab-case data-testid (row-level ids carry the review id), and the data-interactive marker on the root
   flips to "true" once the live circuit is connected.

   The page body is inside SessionGate, which replaces it with a "Session ended" message when the user is no longer
   valid while the page is open. *@
@page "/projects/{ProjectId:int}"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>@(Project?.Name ?? "Project") - ReviewCenter</PageTitle>

<SessionGate>
<main class="page" data-testid="project-page" data-interactive="@InteractiveMarker">
    <nav class="breadcrumb">
        <a href="/projects" data-testid="breadcrumb-projects-link">Projects</a>
        @if (Project is not null)
        {
            <span aria-hidden="true">/</span>
            <span aria-current="page">@Project.Name</span>
        }
    </nav>

    @if (!Loaded)
    {
        <p class="muted" data-testid="project-loading">Loading...</p>
    }
    else if (Project is null)
    {
        <p class="error" role="alert" data-testid="project-not-found">Project @ProjectId does not exist.</p>
    }
    else
    {
        <div class="page-heading">
            <h1 data-testid="project-name">@Project.Name</h1>
            <div class="heading-actions">
                @if (Repositories.Count > 0)
                {
                    <a class="action outline" href="/projects/@ProjectId/plan" data-testid="plan-reviews-link">Plan reviews</a>
                }
                <a class="action" href="/projects/@ProjectId/reviews/new" data-testid="new-review-button">+ New review</a>
            </div>
        </div>
        @if (Project.Description.Length > 0)
        {
            <p class="page-lead" data-testid="project-description">@Project.Description</p>
        }
        @if (Repositories.Count == 0)
        {
            <p class="muted hint" data-testid="plan-reviews-unavailable">Planning reviews needs a registered repository; ask an administrator.</p>
        }

        <h2 class="section-title">Reviews</h2>
        @if (Reviews.Count == 0)
        {
            <p class="muted" data-testid="reviews-empty">This project has no reviews yet. Use + New review to add the first one.</p>
        }
        else
        {
            <ul class="row-list" data-testid="reviews-list">
                @foreach (var review in Reviews)
                {
                    <li class="row-card review-row" data-testid="review-row-@review.Id">
                        <div class="row-main">
                            <a class="row-title" href="/projects/@ProjectId/reviews/@review.Id" data-testid="review-link-@review.Id">@review.Id</a>
                            <p class="muted" data-testid="review-title-@review.Id">@review.Title</p>
                        </div>
                        <div class="row-meta">
                            <span class="badge" data-testid="review-state-@review.Id">@review.State</span>
                            <span class="badge @(IsApproved(review.Id) ? "approved" : null)" data-testid="review-approval-@review.Id">@(IsApproved(review.Id) ? "Approved" : "In review")</span>
                            <time class="muted" datetime="@review.Created.UtcDateTime.ToString("O")" data-testid="review-created-@review.Id">@review.Created.UtcDateTime.ToString("yyyy-MM-dd")</time>
                        </div>
                    </li>
                }
            </ul>
        }
    }
</main>
</SessionGate>
