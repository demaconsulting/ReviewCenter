@* DiffView: the changes of one file, side by side: the baseline on the left and the head on the right.

   Presentation only; state and event handling live in DiffView.razor.cs. From the top: a one-line summary
   ("3 added, 1 removed"), a hint that says how to comment, then the rows. Each row has a left cell (baseline line
   number and text) and a right cell (head line number and text). Unchanged lines show on both sides; a run of
   removed lines is paired row by row with the run of added lines that follows it (see LineDiff.Pair), and the
   leftover cells of the shorter run are muted, empty placeholders. Removed cells are red and added cells green and
   carry a - or + mark. Unchanged rows far from a change are collapsed into a "Show N unchanged lines" button.
   The + control of a left cell comments on the baseline (baseline numbering), the + control of a right cell on the
   head. The threads of the file are drawn under their row across the full width and the new-thread form under the
   selected row; both are supplied by the page. Long lines wrap inside their cell, so the page never scrolls
   sideways; on a narrow screen (see app.css) each row stacks its left cell above its right cell and hides the empty
   placeholders and the repeated left copy of an unchanged line. All file text is rendered as plain text. Every
   interactive element and every key value carries a stable kebab-case data-testid; the cell of a removed line, of
   an added line and the right cell of an unchanged line carry the zero-based row index of that line, the left cell
   of an unchanged line carries it with an "old-" prefix (for example diff-row-old-12). *@
<div class="diff" data-testid="diff-view">
    <p class="diff-summary" data-testid="diff-summary">@SummaryText()</p>
    @if (Result.Lines.Count > 0)
    {
        <p class="muted hint" data-testid="diff-hint">Click + to comment on a line.</p>
    }
    <div class="diff-code" data-testid="diff-content">
        @{
            var composerRow = ComposerRow();
        }
        @foreach (var segment in _segments)
        {
            @if (segment.IsGap)
            {
                var gap = segment;
                <button type="button" class="secondary diff-gap" data-testid="diff-gap-@gap.Start"
                        @onclick="() => Reveal(gap)">Show @gap.Count unchanged lines</button>
            }
            else
            {
                @foreach (var pair in LineDiff.Pair(Result.Lines, segment.Start, segment.Count))
                {
                    var rows = RowsOf(pair);
                    <div class="diff-pair" data-testid="diff-pair-@rows[0]">
                        @Cell(pair.LeftIndex, true, rows[0])
                        @Cell(pair.RightIndex, false, rows[0])
                    </div>
                    @foreach (var row in rows.Where(r => ThreadTemplate is not null && _threadsByRow.ContainsKey(r)))
                    {
                        <div class="diff-inline" data-testid="diff-threads-@row">
                            <ul class="item-list threads">
                                @foreach (var thread in _threadsByRow[row])
                                {
                                    @ThreadTemplate!(thread)
                                }
                            </ul>
                        </div>
                    }

                    @if (rows.Contains(composerRow) && Composer is not null)
                    {
                        <div class="diff-inline diff-composer" data-testid="diff-composer">
                            @Composer
                        </div>
                    }
                }
            }
        }
    </div>
</div>

@code {
    // One cell of a row: the left cell shows the baseline version of a line, the right cell the head version.
    // "anchor" is the row index that names an empty placeholder.
    private RenderFragment Cell(int? index, bool isLeft, int anchor) =>
        index is { } row ? FilledCell(row, isLeft) : EmptyCell(isLeft, anchor);

    // The placeholder of a row that has no line on this side.
    private static RenderFragment EmptyCell(bool isLeft, int anchor) => __builder =>
    {
        var position = isLeft ? "left" : "right";
        <div class="diff-row empty @position" aria-hidden="true" data-testid="diff-empty-@position-@anchor"></div>
    };

    // The cell of a line: its comment button, line number, mark and text.
    private RenderFragment FilledCell(int row, bool isLeft) => __builder =>
    {
        var position = isLeft ? "left" : "right";
        var line = Result.Lines[row];
        var side = isLeft ? ThreadSide.Baseline : ThreadSide.Head;
        var key = CellKey(line, row, isLeft);
        <div class="diff-row @KindClass(line) @position @(IsAnchored(line, side) ? "anchored" : null) @(IsSelected(line, side) ? "selected" : null) @(IsFocused(line, side) ? "focused" : null)"
             data-testid="diff-row-@key" data-kind="@KindClass(line)">
            <span class="gutter">
                <button type="button" class="line-comment" data-testid="diff-comment-@key"
                        aria-label="@CommentLabel(line, side)" title="@CommentLabel(line, side)"
                        @onclick="e => CommentAsync(row, side, e)">+</button>
                @if (isLeft)
                {
                    <span class="line-no" data-testid="diff-old-no-@row">@line.OldNumber</span>
                }
                else
                {
                    <span class="line-no" data-testid="diff-new-no-@row">@line.NewNumber</span>
                }
            </span>
            <span class="diff-sign" aria-hidden="true">@Sign(line)</span>
            <span class="line-text" data-testid="diff-text-@key">@line.Text</span>
        </div>
    };
}
