@* RepositoriesPage: the git repositories of one project, at "/projects/{id}/repositories", for whoever manages the
   project (a system administrator or a project admin of it); anybody else gets the same not-found message as for a
   project that does not exist.

   Presentation only; state and event handling live in RepositoriesPage.razor.cs. A list of the repositories of the
   project with, per repository, its location, user name, whether a token is set ("token set" or "no token", never
   the token), the controls to disable or enable it and to edit it; a "+ Add repository" button leads to the
   separate form page at "/projects/{id}/repositories/new". The token is write-only: it is typed into a password
   field, sent once and never shown again; an edit keeps, replaces or clears the stored token. A repository is never
   deleted, only disabled. Every interactive element and every key value carries a stable kebab-case data-testid
   (row-level ids carry the repository id), and the data-interactive marker on the root flips to "true" once the
   live circuit is connected.

   Human factors: (a) name, location and whether a token is set are on the row; (b) only this project's repositories
   are listed, and the rare edit form opens inside the row; (c) the empty state says to use + Add repository, and
   a project member who may not manage it never gets here (the Repositories button on the project page is hidden).

   The page body is inside SessionGate, which replaces it with a "Session ended" message when the user is no longer
   valid while the page is open. *@
@page "/projects/{ProjectId:int}/repositories"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Repositories - ReviewCenter</PageTitle>

<SessionGate>
<main class="page" data-testid="repositories-page" data-interactive="@InteractiveMarker">
    <nav class="breadcrumb">
        <a href="/projects" data-testid="breadcrumb-projects-link">Projects</a>
        @if (Project is not null)
        {
            <span aria-hidden="true">/</span>
            <a href="/projects/@ProjectId" data-testid="breadcrumb-project-link">@Project.Name</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Repositories</span>
        }
    </nav>

    @if (!Loaded)
    {
        <p class="muted" data-testid="repositories-loading">Loading...</p>
    }
    else if (Project is null)
    {
        <p class="error" role="alert" data-testid="project-not-found">Project @ProjectId does not exist.</p>
    }
    else
    {
    <div class="page-heading">
        <h1>Repositories</h1>
        <a class="action" href="/projects/@ProjectId/repositories/new" data-testid="new-repository-button">+ Add repository</a>
    </div>
    <p class="page-lead">
        Git repositories that reviews of this project can be created from. A repository can be disabled but not
        removed.
    </p>

    @if (MessageRepositoryId is null)
    {
        if (ErrorMessage is not null)
        {
            <p class="error" role="alert" data-testid="repositories-error">@ErrorMessage</p>
        }
        if (StatusMessage is not null)
        {
            <p class="notice" role="status" data-testid="repositories-status">@StatusMessage</p>
        }
    }

    @if (Repositories.Count == 0)
    {
        <p class="muted" data-testid="repositories-empty">No repositories are registered yet. Use + Add repository to register the first one.</p>
    }
    else
    {
        <ul class="row-list" data-testid="repositories-list">
            @foreach (var repository in Repositories)
            {
                var repositoryId = repository.Id;
                <li class="row-card static-row" data-testid="repository-row-@repositoryId">
                    <div class="row-main">
                        <strong class="row-title" data-testid="repository-name-@repositoryId">@repository.Name</strong>
                        <p class="muted mono" data-testid="repository-location-@repositoryId">@repository.Location</p>
                        <p class="row-badges">
                            <span class="badge @(repository.Enabled ? "approved" : null)" data-testid="repository-enabled-@repositoryId">@(repository.Enabled ? "Enabled" : "Disabled")</span>
                            @if (repository.HasToken)
                            {
                                <span class="badge" data-testid="repository-token-state-@repositoryId">token set</span>
                            }
                            @if (repository.Username is not null)
                            {
                                <span class="badge" data-testid="repository-username-@repositoryId">user @repository.Username</span>
                            }
                        </p>
                    </div>
                    <div class="row-actions">
                        <button type="button" class="outline small" data-testid="repository-toggle-enabled-@repositoryId"
                                @onclick="() => ToggleEnabledAsync(repository)">@(repository.Enabled ? "Disable" : "Enable")</button>
                        <button type="button" class="outline small" data-testid="repository-edit-@repositoryId"
                                @onclick="() => StartEdit(repository)">Edit</button>
                    </div>
                    @if (EditingId == repositoryId)
                    {
                        <form class="inline-form" data-testid="repository-edit-form-@repositoryId" @onsubmit="SaveEditAsync">
                            <div class="field">
                                <label for="edit-repository-name-@repositoryId">Name</label>
                                <input id="edit-repository-name-@repositoryId" type="text"
                                       maxlength="@RepositoryService.MaxNameLength" autocomplete="off"
                                       data-testid="edit-repository-name-input" @bind="EditName" @bind:event="oninput" />
                            </div>
                            <div class="field">
                                <label for="edit-repository-location-@repositoryId">Location</label>
                                <input id="edit-repository-location-@repositoryId" type="text"
                                       maxlength="@RepositoryService.MaxLocationLength" autocomplete="off"
                                       data-testid="edit-repository-location-input" @bind="EditLocation" @bind:event="oninput" />
                            </div>
                            <div class="field">
                                <label for="edit-repository-username-@repositoryId">User name</label>
                                <input id="edit-repository-username-@repositoryId" type="text"
                                       maxlength="@RepositoryService.MaxUsernameLength" autocomplete="off"
                                       data-testid="edit-repository-username-input" @bind="EditUsername" @bind:event="oninput" />
                            </div>
                            <div class="field">
                                <label for="edit-repository-token-action-@repositoryId">Token</label>
                                <select id="edit-repository-token-action-@repositoryId"
                                        data-testid="edit-repository-token-action-select" @bind="EditTokenAction">
                                    <option value="@TokenAction.Keep">Keep the stored token</option>
                                    <option value="@TokenAction.Replace">Replace the token</option>
                                    <option value="@TokenAction.Clear">Clear the token</option>
                                </select>
                            </div>
                            @if (EditTokenAction == TokenAction.Replace)
                            {
                                <div class="field">
                                    <label for="edit-repository-token-@repositoryId">New token</label>
                                    <input id="edit-repository-token-@repositoryId" type="password" autocomplete="new-password"
                                           maxlength="@RepositoryService.MaxTokenLength"
                                           data-testid="edit-repository-token-input" @bind="EditToken" @bind:event="oninput" />
                                </div>
                            }
                            <div class="plan-actions">
                                <button type="submit" data-testid="edit-repository-save-button">Save</button>
                                <button type="button" class="outline" data-testid="edit-repository-cancel-button" @onclick="CancelEdit">Cancel</button>
                            </div>
                        </form>
                    }
                    @if (MessageRepositoryId == repositoryId)
                    {
                        if (ErrorMessage is not null)
                        {
                            <p class="error" role="alert" data-testid="repositories-error">@ErrorMessage</p>
                        }
                        if (StatusMessage is not null)
                        {
                            <p class="notice" role="status" data-testid="repositories-status">@StatusMessage</p>
                        }
                    }
                </li>
            }
        </ul>
    }
    }
</main>
</SessionGate>
