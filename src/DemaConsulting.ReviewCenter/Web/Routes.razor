@* Routes: maps the requested URL to a page component (part of the App unit).

   Unknown URLs fall through to a "Page not found" page, shown inside MainLayout so that it has the same header
   and footer as every other page, and so that a mistyped address gives the user a clear answer and a way back
   instead of a blank page.

   AuthorizeRouteView applies the [Authorize] rules of a page also when the user navigates inside an open
   interactive circuit, where the endpoint check does not run (RouteView would ignore them). A signed-out
   user is pointed to the login page; a signed-in user without the needed role sees the same "Access denied"
   explanation as the endpoint check gives.

   In production this component is rendered statically, so it only decides for the first request of a page.
   An open page whose user is disabled, removed or changed is handled by SessionGate inside the page. *@
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized Context="state">
                <main class="page narrow" data-testid="access-denied">
                    @if (state.User.Identity?.IsAuthenticated == true)
                    {
                        <h1>Access denied</h1>
                        <p>Your account does not have permission to open this page.</p>
                        <p><a class="action outline" href="/projects" data-testid="access-denied-projects-link">Back to projects</a></p>
                    }
                    else
                    {
                        <h1>Sign in required</h1>
                        <p>Please sign in to open this page.</p>
                        <p>
                            <a class="action" href="@LoginLink" data-testid="access-denied-login-link">Go to the login page</a>
                        </p>
                    }
                </main>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <main class="page narrow" data-testid="not-found">
                <h1>Page not found</h1>
                <p>The address you asked for does not match any page. It may have been mistyped or the page may have moved.</p>
                <p><a class="action outline" href="/projects" data-testid="not-found-projects-link">Back to projects</a></p>
            </main>
        </LayoutView>
    </NotFound>
</Router>

@code {
    /// <summary>
    ///     Gets the login page address that returns to the page the user asked for.
    /// </summary>
    private string LoginLink => "/login?ReturnUrl=" + Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
}
