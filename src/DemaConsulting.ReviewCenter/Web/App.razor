@* App: the HTML shell and root component of the ReviewCenter web UI.

   This is static server-side rendered markup: it emits the document skeleton, the router that
   selects a page for the requested URL, and the Blazor client script that upgrades interactive
   pages to a live server connection. Pages opt in to interactivity individually (see HomePage),
   so everything outside a page stays cheap, static HTML. It also carries one tiny script: the scroll
   helper that the review page calls to bring a thread's lines into view (Blazor cannot scroll by itself) and the
   helper that replaces the address in the address bar by the link of the file or thread shown (history.replaceState:
   no navigation and no history entry, so the page keeps its state), the focus helper that puts the keyboard focus
   into the comment field when it opens, a Ctrl+Enter listener that presses the button named by a field's
   data-ctrl-enter-submits attribute, the copy helper behind a thread's
   "Copy link" button (clipboard API, with a textarea fallback outside secure contexts) and the download helper behind
   the checklist template export (a Blob behind a temporary link). A second script in the head applies the stored
   light/dark/system appearance before the first paint. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        // Appearance: runs before the first paint so a stored dark choice never flashes light. The choice (system,
        // light or dark) lives in this browser's localStorage only; "system" follows prefers-color-scheme and the
        // result is published as data-theme="light|dark" on the html element. Storage may be blocked: always guarded.
        (function () {
            var key = 'reviewcenter-theme';
            function stored() {
                try {
                    var value = window.localStorage.getItem(key);
                    return value === 'light' || value === 'dark' ? value : 'system';
                } catch (e) { return 'system'; }
            }
            function systemDark() {
                try { return window.matchMedia('(prefers-color-scheme: dark)').matches; } catch (e) { return false; }
            }
            function apply(choice) {
                var dark = choice === 'dark' || (choice === 'system' && systemDark());
                var root = document.documentElement;
                root.setAttribute('data-theme', dark ? 'dark' : 'light');
                root.setAttribute('data-theme-choice', choice);
                root.style.colorScheme = dark ? 'dark' : 'light';
            }
            apply(stored());
            try {
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () { apply(stored()); });
                // Enhanced navigation may rebuild the html element's attributes; put the theme back if it goes missing
                new MutationObserver(function () {
                    if (!document.documentElement.hasAttribute('data-theme')) { apply(stored()); }
                }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
            } catch (e) { }
            window.reviewCenter = window.reviewCenter || {};
            window.reviewCenter.getTheme = function () { return stored(); };
            window.reviewCenter.setTheme = function (choice) {
                if (choice !== 'light' && choice !== 'dark') { choice = 'system'; }
                try {
                    if (choice === 'system') { window.localStorage.removeItem(key); }
                    else { window.localStorage.setItem(key, choice); }
                } catch (e) { }
                apply(choice);
            };
        })();
    </script>
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script>
        window.reviewCenter = window.reviewCenter || {};
        Object.assign(window.reviewCenter, {
            scrollToTestId: function (id, block) {
                var element = document.querySelector('[data-testid="' + id + '"]');
                if (element) { element.scrollIntoView({ block: block }); }
            },
            focusTestId: function (id) {
                // Moves the keyboard focus (without scrolling; the scroll helper has already placed the element)
                var element = document.querySelector('[data-testid="' + id + '"]');
                if (element) { element.focus({ preventScroll: true }); }
            },
            replaceUrl: function (url) {
                // Same-origin relative links only; keeps the history state Blazor stores on the entry
                if (typeof url === 'string' && url.charAt(0) === '/' && url.charAt(1) !== '/') {
                    history.replaceState(history.state, '', url);
                }
            },
            copyText: function (text) {
                // Resolves true when the text reached the clipboard and false otherwise; never rejects. The
                // clipboard API needs a secure context, so a hidden textarea and execCommand('copy') is the fallback.
                var fallback = function () {
                    var box = document.createElement('textarea');
                    box.value = text;
                    box.setAttribute('readonly', '');
                    box.style.position = 'fixed';
                    box.style.opacity = '0';
                    document.body.appendChild(box);
                    try {
                        box.select();
                        return document.execCommand('copy');
                    } catch (e) {
                        return false;
                    } finally {
                        document.body.removeChild(box);
                    }
                };
                if (window.isSecureContext && navigator.clipboard) {
                    return navigator.clipboard.writeText(text).then(function () { return true; }, function () { return fallback(); });
                }
                return Promise.resolve(fallback());
            },
            downloadText: function (fileName, text, contentType) {
                // Offers the text as a file download in the browser (a Blob behind a temporary link); nothing is
                // sent to the server. The file name is a plain name chosen by the page, never a path.
                var url = URL.createObjectURL(new Blob([text], { type: contentType || 'text/plain' }));
                var link = document.createElement('a');
                link.href = url;
                link.download = fileName;
                link.style.display = 'none';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(function () { URL.revokeObjectURL(url); }, 0);
            }
        });
        // Ctrl+Enter (Cmd+Enter on a Mac) in a field that names a button through data-ctrl-enter-submits presses that
        // button, so a comment can be sent from the keyboard. It runs in the browser: no server round trip per key.
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter' || !(e.ctrlKey || e.metaKey) || e.isComposing || !e.target || !e.target.getAttribute) { return; }
            var id = e.target.getAttribute('data-ctrl-enter-submits');
            var button = id ? document.querySelector('[data-testid="' + id + '"]') : null;
            if (button && !button.disabled) {
                e.preventDefault();
                button.click();
            }
        });
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
