@* UsersPage: user administration for administrators, at "/users".

   Presentation only; state and event handling live in UsersPage.razor.cs. A list of all users with, per user,
   the controls to disable or enable the account, to set the role and to set a new password; a "+ New user"
   button leads to the separate form page at "/users/new". Access is limited to the Admin role by the attribute
   below. Every interactive element and every key value carries a stable kebab-case data-testid (row-level ids
   carry the user id), and the data-interactive marker on the root flips to "true" once the live circuit is
   connected.

   The page body is inside SessionGate, which replaces it with a "Session ended" message when the user is no longer
   valid while the page is open. *@
@page "/users"
@using DemaConsulting.ReviewCenter.Identity
@rendermode InteractiveServer
@attribute [Authorize(Roles = SignIn.AdminRole)]

<PageTitle>Users - ReviewCenter</PageTitle>

<SessionGate>
<main class="page" data-testid="users-page" data-interactive="@InteractiveMarker">
    <div class="page-heading">
        <h1>Users</h1>
        <a class="action" href="/users/new" data-testid="new-user-button">+ New user</a>
    </div>
    <p class="page-lead">Everyone who can sign in. Administrators manage users, repositories and the audit trail.</p>

    @if (MessageUserId is null)
    {
        if (ErrorMessage is not null)
        {
            <p class="error" role="alert" data-testid="users-error">@ErrorMessage</p>
        }
        if (StatusMessage is not null)
        {
            <p class="notice" role="status" data-testid="users-status">@StatusMessage</p>
        }
    }

    <ul class="row-list" data-testid="users-list">
        @foreach (var user in Users)
        {
            var userId = user.Id;
            var username = user.Username;
            <li class="row-card static-row" data-testid="user-row-@userId">
                <div class="row-main">
                    <strong class="row-title" data-testid="user-username-@userId">@user.Username</strong>
                    <p class="muted" data-testid="user-display-name-@userId">@user.DisplayName</p>
                    <p class="row-badges">
                        <span class="badge" data-testid="user-role-@userId">@user.Role</span>
                        <span class="badge @(user.Enabled ? "approved" : null)" data-testid="user-enabled-@userId">@(user.Enabled ? "Enabled" : "Disabled")</span>
                    </p>
                </div>
                <div class="row-actions">
                    <button type="button" class="outline small" data-testid="user-toggle-enabled-@userId"
                            @onclick="() => ToggleEnabledAsync(user)">@(user.Enabled ? "Disable" : "Enable")</button>
                </div>
                <div class="user-controls">
                    <div class="control-group">
                        <select aria-label="Role of @username" data-testid="user-role-select-@userId"
                                @bind:get="RoleChoice(user)" @bind:set="value => RoleChoices[userId] = value">
                            @foreach (var role in Enum.GetValues<UserRole>())
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <button type="button" class="outline small" data-testid="user-set-role-@userId"
                                @onclick="() => SetRoleAsync(user)">Set role</button>
                    </div>
                    <div class="control-group grow">
                        <input type="password" autocomplete="new-password" aria-label="New password for @username"
                               placeholder="New password (at least @ReviewLimits.MinPasswordLength characters)"
                               maxlength="@ReviewLimits.MaxPasswordLength"
                               data-testid="user-password-input-@userId"
                               @bind:get="PasswordChoice(userId)" @bind:set="value => SetPasswordChoice(userId, value)"
                               @bind:event="oninput" />
                        <button type="button" class="outline small" data-testid="user-set-password-@userId"
                                @onclick="() => SetPasswordAsync(user)">Set password</button>
                    </div>
                </div>
                @if (MessageUserId == userId)
                {
                    if (ErrorMessage is not null)
                    {
                        <p class="error row-message" role="alert" data-testid="users-error">@ErrorMessage</p>
                    }
                    if (StatusMessage is not null)
                    {
                        <p class="notice row-message" role="status" data-testid="users-status">@StatusMessage</p>
                    }
                }
            </li>
        }
    </ul>
</main>
</SessionGate>
