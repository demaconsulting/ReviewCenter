<Project Sdk="Microsoft.NET.Sdk">

  <!-- Puppet: an in-repo command-line tool that lets AI agents drive the ReviewCenter web UI in a headless browser.
       It is a thin client and daemon around the Puppeting test-support library (test/DemaConsulting.ReviewCenter.Puppeting).
       It is NOT part of the distributed ReviewCenter package: nothing here is packed or published. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DemaConsulting.ReviewCenter.Puppet</AssemblyName>
    <RootNamespace>DemaConsulting.ReviewCenter.Puppet</RootNamespace>

    <!-- Developer tool only: never packed as a NuGet package -->
    <IsPackable>false</IsPackable>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Runtime Dependencies -->
  <ItemGroup>
    <!-- The browser automation; it brings Playwright, whose playwright.ps1 the build copies to the output folder -->
    <ProjectReference Include="..\..\test\DemaConsulting.ReviewCenter.Puppeting\DemaConsulting.ReviewCenter.Puppeting.csproj" />
  </ItemGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="Polyfill" Version="11.4.5" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Child-element form configures both PrivateAssets and IncludeAssets so the analyzers are fully
         activated during the build without becoming transitive dependencies. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.ReviewCenter.Puppet.Tests" />
  </ItemGroup>

</Project>
