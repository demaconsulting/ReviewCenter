{
  "openapi": "3.1.1",
  "info": {
    "title": "ReviewCenter API",
    "description": "Read projects and reviews, create review drafts and download attestations with a personal access token (Authorization: Bearer rcpat_...). Reviewer slots and signatures can only be changed in the web pages.",
    "version": "1"
  },
  "paths": {
    "/api/projects": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Lists the projects.",
        "description": "Returns every project, in the order of the project list of the web pages.",
        "operationId": "ListProjects",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [ ]
          }
        ]
      }
    },
    "/api/projects/{projectId}/reviews": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Lists the reviews of a project.",
        "description": "Returns the reviews of the project, ordered by their identifier, without their details.",
        "operationId": "ListReviews",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReviewSummaryDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [ ]
          }
        ]
      },
      "post": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Creates a review.",
        "description": "Creates a draft review from uploaded files (Base64) or from a registered git repository; send exactly one of 'files' and 'repository'. The review is recorded as created with an API token. Reviewer slots and signatures cannot be changed with an API token.",
        "operationId": "CreateReview",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/CreateReviewRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedReviewDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [ ]
          }
        ]
      }
    },
    "/api/projects/{projectId}/reviews/{reviewId}": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Gets a review.",
        "description": "Returns the review with its reviewer slots, approval status, progress counts and next step.",
        "operationId": "GetReview",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "reviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewDetailDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [ ]
          }
        ]
      }
    },
    "/api/projects/{projectId}/reviews/{reviewId}/attestation.pdf": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Downloads the signed attestation of a complete review.",
        "description": "Returns the signed PDF attestation; the review must be complete (every slot signed).",
        "operationId": "GetAttestation",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "reviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreatedReviewDto": {
        "required": [
          "review",
          "skipped"
        ],
        "type": "object",
        "properties": {
          "review": {
            "description": "The review that was created.",
            "$ref": "#/components/schemas/ReviewDetailDto"
          },
          "skipped": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkippedFileDto"
            },
            "description": "The repository entries that were left out; empty for an upload."
          }
        },
        "description": "The answer to creating a review."
      },
      "CreateReviewRequest": {
        "required": [
          "id",
          "title",
          "files",
          "repository"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ],
            "description": "The review identifier: letters, digits, '.', '_' and '-', starting with a letter or digit."
          },
          "title": {
            "type": [
              "null",
              "string"
            ],
            "description": "The review title."
          },
          "files": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/UploadFileDto"
            },
            "description": "The files to review; set this or Repository."
          },
          "repository": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The repository source to review; set this or Files.",
                "$ref": "#/components/schemas/RepositorySourceDto"
              }
            ]
          }
        },
        "description": "The request to create a review: either uploaded files or a repository source, never both."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProjectDto": {
        "required": [
          "id",
          "name",
          "description",
          "created"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The project number.",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "description": "The project name."
          },
          "description": {
            "type": "string",
            "description": "The project description; empty when there is none."
          },
          "created": {
            "type": "string",
            "description": "When the project was created.",
            "format": "date-time"
          }
        },
        "description": "A project as the API shows it."
      },
      "RepositorySourceDto": {
        "required": [
          "repositoryId",
          "headRevision",
          "baselineRevision",
          "selection"
        ],
        "type": "object",
        "properties": {
          "repositoryId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The identity of an enabled registered repository.",
            "format": "int32"
          },
          "headRevision": {
            "type": "string",
            "description": "The head revision: a branch, tag or commit."
          },
          "baselineRevision": {
            "type": [
              "null",
              "string"
            ],
            "description": "The baseline revision, or `null` to review every file at the head as added."
          },
          "selection": {
            "type": [
              "null",
              "string"
            ],
            "description": "The file selection patterns, one per line, or `null` to review every changed file."
          }
        },
        "description": "A git repository source of a review."
      },
      "ReviewCountsDto": {
        "required": [
          "files",
          "openThreads",
          "resolvedThreads",
          "checklistItems",
          "checklistAnswered",
          "checklistFailed"
        ],
        "type": "object",
        "properties": {
          "files": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of files in the review.",
            "format": "int32"
          },
          "openThreads": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of comment threads that are open.",
            "format": "int32"
          },
          "resolvedThreads": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of comment threads that are resolved.",
            "format": "int32"
          },
          "checklistItems": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of checklist items that apply to the review.",
            "format": "int32"
          },
          "checklistAnswered": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of applicable checklist items that have an answer.",
            "format": "int32"
          },
          "checklistFailed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of applicable checklist items answered as failed.",
            "format": "int32"
          }
        },
        "description": "The counts that summarize the progress of a review."
      },
      "ReviewDetailDto": {
        "required": [
          "id",
          "title",
          "state",
          "created",
          "contentFingerprint",
          "createdBy",
          "createdViaApi",
          "isFromRepository",
          "repositoryName",
          "baselineSha",
          "headSha",
          "selection",
          "reviewSetId",
          "approved",
          "approvalDigest",
          "slots",
          "counts",
          "blockers",
          "nextStep"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The review identifier, unique within its project."
          },
          "title": {
            "type": "string",
            "description": "The review title."
          },
          "state": {
            "type": "string",
            "description": "The life-cycle state of the review, for example `Draft`."
          },
          "created": {
            "type": "string",
            "description": "When the review was created.",
            "format": "date-time"
          },
          "contentFingerprint": {
            "type": "string",
            "description": "The fingerprint of the reviewed content."
          },
          "createdBy": {
            "type": [
              "null",
              "string"
            ],
            "description": "The user name of the creator, or `null` when it was not recorded."
          },
          "createdViaApi": {
            "type": "boolean",
            "description": "`true` when the review was created with an API token."
          },
          "isFromRepository": {
            "type": "boolean",
            "description": "`true` when the review was created from a git repository, `false` for an upload."
          },
          "repositoryName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name of the registered repository, or `null` for an upload."
          },
          "baselineSha": {
            "type": [
              "null",
              "string"
            ],
            "description": "The baseline commit, or `null` when there is none."
          },
          "headSha": {
            "type": [
              "null",
              "string"
            ],
            "description": "The head commit, or `null` for an upload."
          },
          "selection": {
            "type": [
              "null",
              "string"
            ],
            "description": "The file selection patterns that were used, or `null` when none."
          },
          "reviewSetId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The review-set the review was planned from, or `null`."
          },
          "approved": {
            "type": "boolean",
            "description": "`true` when every reviewer slot has signed the current record."
          },
          "approvalDigest": {
            "type": "string",
            "description": "The digest of the review record as it is now."
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotDto"
            },
            "description": "The reviewer slots in creation order."
          },
          "counts": {
            "description": "The progress counts.",
            "$ref": "#/components/schemas/ReviewCountsDto"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The plain-language reasons the review cannot be signed yet; empty when it can be."
          },
          "nextStep": {
            "type": "string",
            "description": "One short sentence that words what to do next."
          }
        },
        "description": "A review with its details, approval status and counts."
      },
      "ReviewSummaryDto": {
        "required": [
          "id",
          "title",
          "state",
          "created",
          "contentFingerprint",
          "createdBy",
          "createdViaApi",
          "isFromRepository"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The review identifier, unique within its project."
          },
          "title": {
            "type": "string",
            "description": "The review title."
          },
          "state": {
            "type": "string",
            "description": "The life-cycle state of the review, for example `Draft`."
          },
          "created": {
            "type": "string",
            "description": "When the review was created.",
            "format": "date-time"
          },
          "contentFingerprint": {
            "type": "string",
            "description": "The fingerprint of the reviewed content."
          },
          "createdBy": {
            "type": [
              "null",
              "string"
            ],
            "description": "The user name of the creator, or `null` when it was not recorded."
          },
          "createdViaApi": {
            "type": "boolean",
            "description": "`true` when the review was created with an API token."
          },
          "isFromRepository": {
            "type": "boolean",
            "description": "`true` when the review was created from a git repository, `false` for an upload."
          }
        },
        "description": "A review in a list, without its details."
      },
      "SkippedFileDto": {
        "required": [
          "path",
          "reason"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The path of the entry."
          },
          "reason": {
            "type": "string",
            "description": "Why the entry was skipped."
          }
        },
        "description": "A repository entry that was left out of a review."
      },
      "SlotDto": {
        "required": [
          "id",
          "number",
          "primary",
          "alternate",
          "state",
          "signedBy",
          "signedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The identity of the slot.",
            "format": "int32"
          },
          "number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The position of the slot among the slots of the review, starting at 1.",
            "format": "int32"
          },
          "primary": {
            "type": "string",
            "description": "The user name of the primary reviewer."
          },
          "alternate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The user name of the alternate reviewer, or `null` when the slot has none."
          },
          "state": {
            "type": "string",
            "description": "Whether the slot holds a signature of the current record: `NotSigned`, `Signed` or `OutOfDate`."
          },
          "signedBy": {
            "type": [
              "null",
              "string"
            ],
            "description": "The display name of the signer of the current signature, or `null` when the slot is not signed."
          },
          "signedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "The time of the current signature, or `null` when the slot is not signed.",
            "format": "date-time"
          }
        },
        "description": "A reviewer slot of a review."
      },
      "UploadFileDto": {
        "required": [
          "path",
          "contentBase64"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The path of the file within the review, with forward slashes."
          },
          "contentBase64": {
            "type": "string",
            "description": "The content of the file, Base64 encoded."
          }
        },
        "description": "One file of an upload."
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "description": "A personal access token created on the Account page.",
        "scheme": "bearer",
        "bearerFormat": "rcpat"
      }
    }
  },
  "tags": [
    {
      "name": "ApiEndpoints"
    }
  ]
}
