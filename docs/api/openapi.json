          }
        },
        "description": "A reviewer slot of a review."
      },
      "UploadFileDto": {
        "required": [
          "path",
          "contentBase64"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The path of the file within the review, with forward slashes."
          },
          "contentBase64": {
            "type": "string",
            "description": "The content of the file, Base64 encoded."
          }
        },
        "description": "One file of an upload."
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "description": "A personal access token created on the Account page.",
        "scheme": "bearer",
        "bearerFormat": "rcpat"
      },
      "basic": {
        "type": "http",
        "description": "HTTP Basic for tools that cannot send a bearer token, such as ReviewMark: the user name is ignored and the password is a personal access token.",
        "scheme": "basic"
      }
    }
  },
