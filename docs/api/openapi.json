{
  "openapi": "3.1.1",
  "info": {
    "title": "ReviewCenter API",
    "description": "Read projects and reviews, create review drafts, download attestations and read the evidence index with a personal access token (bearer token, or HTTP Basic with the token as the password). A project can open its evidence index and its attestation PDFs to callers without a token. Reviewer slots and signatures can only be changed in the web pages.",
    "version": "1"
  },
  "paths": {
    "/api/projects": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Lists the projects.",
        "description": "Returns the projects the owner of the token may see (a system administrator sees all, anybody else only the projects they are a member of), in the order of the project list of the web pages.",
        "operationId": "ListProjects",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [ ]
          },
          {
            "basic": [ ]
          }
        ]
      }
    },
    "/api/projects/{projectId}/checklist": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Gets the checklist template of a project.",
        "description": "Returns the checklist that new reviews of the project start with: its definition (sections and checks), the version label, whether it is the built-in default, the SHA-256 hash of the definition text, and the number of sections and checks. Existing reviews keep the checklist they were created with. The template can be changed on the web pages only.",
        "operationId": "GetChecklist",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectChecklistDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [ ]
          },
          {
            "basic": [ ]
          }
        ]
      }
    },
    "/api/projects/{projectId}/reviews": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Lists the reviews of a project.",
        "description": "Returns the reviews of the project, ordered by their identifier, without their details; each with its due date and whether it is overdue.",
        "operationId": "ListReviews",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReviewSummaryDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [ ]
          },
          {
            "basic": [ ]
          }
        ]
      },
      "post": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Creates a review.",
        "description": "Creates a draft review from uploaded files (Base64) or from a registered git repository; send exactly one of 'files' and 'repository'. The optional 'dueDate' is a UTC calendar day (yyyy-MM-dd), not before today and not more than two years ahead. The optional 'followsReviewId' names an earlier review of the project to follow up: its Pass and not-applicable answers, not-applicable sections and open threads are carried over, and 'acknowledgeDroppedThreads' confirms that open threads on files that are not in the new review are not carried (an unfit review or an unacknowledged drop is a 400 problem). The review is recorded as created with an API token. Reviewer slots and signatures cannot be changed with an API token.",
        "operationId": "CreateReview",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedReviewDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [ ]
          },
          {
            "basic": [ ]
          }
        ]
      }
    },
    "/api/projects/{projectId}/reviews/{reviewId}": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Gets a review.",
        "description": "Returns the review with its reviewer slots, approval status, progress counts and next step.",
        "operationId": "GetReview",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "reviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewDetailDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [ ]
          },
          {
            "basic": [ ]
          }
        ]
      }
    },
    "/api/projects/{projectId}/reviews/{reviewId}/attestation.pdf": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Downloads the signed attestation of a complete review.",
        "description": "Returns the signed PDF attestation; the review must be complete (every slot signed). What the PDF contains follows the evidence settings of the project. Without a token the request is answered only when the project allows anonymous attestation PDFs; otherwise the answer is 401.",
        "operationId": "GetAttestation",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "reviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [ ]
          },
          {
            "basic": [ ]
          },
          { }
        ]
      }
    },
    "/api/projects/{projectId}/evidence/index.json": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Gets the evidence index of a project, in the format of a ReviewMark index.json.",
        "description": "Returns the completed reviews of the project that were planned from a review-set, one per review-set id and fingerprint, as {\"reviews\":[{id, fingerprint, date, result, file}]}. The result is always 'pass'; 'file' is the absolute address of the signed attestation. Use it as the evidence-source of a .reviewmark.yaml file, with a personal access token as the Basic password. Without a token the request is answered only when the project allows an anonymous evidence index; otherwise the answer is 401.",
        "operationId": "GetEvidenceIndex",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceIndexDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [ ]
          },
          {
            "basic": [ ]
          },
          { }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ChecklistDefinitionDto": {
        "required": [
          "version",
          "sections"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "The version label of the wording."
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChecklistSectionDto"
            },
            "description": "The sections, in order."
          }
        },
        "description": "A checklist definition: a version label and its sections."
      },
      "ChecklistItemDto": {
        "required": [
          "id",
          "text"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The identifier of the check, unique within the definition."
          },
          "text": {
            "type": "string",
            "description": "The wording of the check."
          }
        },
        "description": "One check of a checklist definition."
      },
      "ChecklistSectionDto": {
        "required": [
          "id",
          "title",
          "applicabilityHint",
          "items"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The identifier of the section, unique within the definition."
          },
          "title": {
            "type": "string",
            "description": "The title of the section."
          },
          "applicabilityHint": {
            "type": "string",
            "description": "A short hint when the section applies; empty when there is none."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChecklistItemDto"
            },
            "description": "The checks of the section, in order."
          }
        },
        "description": "One section of a checklist definition: a group of checks that applies to a review as a whole or not at all."
      },
      "CreatedReviewDto": {
        "required": [
          "review",
          "skipped"
        ],
        "type": "object",
        "properties": {
          "review": {
            "description": "The review that was created.",
            "$ref": "#/components/schemas/ReviewDetailDto"
          },
          "skipped": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkippedFileDto"
            },
            "description": "The repository entries that were left out; empty for an upload."
          }
        },
        "description": "The answer to creating a review."
      },
      "CreateReviewRequest": {
        "required": [
          "id",
          "title"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ],
            "description": "The review identifier: letters, digits, '.', '_' and '-', starting with a letter or digit."
          },
          "title": {
            "type": [
              "null",
              "string"
            ],
            "description": "The review title."
          },
          "files": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/UploadFileDto"
            },
            "description": "The files to review; set this or Repository."
          },
          "repository": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The repository source to review; set this or Files.",
                "$ref": "#/components/schemas/RepositorySourceDto"
              }
            ]
          },
          "dueDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The optional due date (UTC calendar day, `yyyy-MM-dd`): not before today, at most two years ahead."
          },
          "followsReviewId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The optional identifier of an earlier review of the same project that the new review follows up; Pass and not-applicable answers, not-applicable sections and open threads of that review are carried over."
          },
          "acknowledgeDroppedThreads": {
            "type": "boolean",
            "description": "`true` to confirm that open threads of the followed review on files that are not in the new review are not carried over; without it such a case is refused.",
            "default": false
          }
        },
        "description": "The request to create a review: either uploaded files or a repository source, never both."
      },
      "EvidenceEntryDto": {
        "required": [
          "id",
          "fingerprint",
          "date",
          "result",
          "file"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The review-set id of the review (the ReviewMark review id)."
          },
          "fingerprint": {
            "type": "string",
            "description": "The content fingerprint of the review's file set."
          },
          "date": {
            "type": "string",
            "description": "The day of the latest signature, as a UTC date in `yyyy-MM-dd` form."
          },
          "result": {
            "type": "string",
            "description": "The result of the review; always `pass`."
          },
          "file": {
            "type": "string",
            "description": "The absolute address of the signed attestation of the review."
          }
        },
        "description": "One completed review in the evidence index, as ReviewMark reads it."
      },
      "EvidenceIndexDto": {
        "required": [
          "reviews"
        ],
        "type": "object",
        "properties": {
          "reviews": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceEntryDto"
            },
            "description": "The completed reviews, one per review-set id and fingerprint, in a fixed order."
          }
        },
        "description": "The evidence index of a project: the document ReviewMark reads as its `index.json`."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProjectChecklistDto": {
        "required": [
          "version",
          "isDefault",
          "hash",
          "sectionCount",
          "itemCount",
          "definition"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "The version label of the definition."
          },
          "isDefault": {
            "type": "boolean",
            "description": "`true` when the project uses the built-in default checklist."
          },
          "hash": {
            "type": "string",
            "description": "The SHA-256 hash of the definition text, in lower-case hexadecimal; it changes when the definition changes."
          },
          "sectionCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of sections.",
            "format": "int32"
          },
          "itemCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of checks in all sections.",
            "format": "int32"
          },
          "definition": {
            "description": "The definition itself.",
            "$ref": "#/components/schemas/ChecklistDefinitionDto"
          }
        },
        "description": "The checklist template of a project: what new reviews of the project start with."
      },
      "ProjectDto": {
        "required": [
          "id",
          "name",
          "description",
          "created"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The project number.",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "description": "The project name."
          },
          "description": {
            "type": "string",
            "description": "The project description; empty when there is none."
          },
          "created": {
            "type": "string",
            "description": "When the project was created.",
            "format": "date-time"
          }
        },
        "description": "A project as the API shows it."
      },
      "RepositorySourceDto": {
        "required": [
          "repositoryId",
          "headRevision"
        ],
        "type": "object",
        "properties": {
          "repositoryId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The identity of an enabled registered repository.",
            "format": "int32"
          },
          "headRevision": {
            "type": "string",
            "description": "The head revision: a branch, tag or commit."
          },
          "baselineRevision": {
            "type": [
              "null",
              "string"
            ],
            "description": "The baseline revision, or `null` to review every file at the head as added."
          },
          "selection": {
            "type": [
              "null",
              "string"
            ],
            "description": "The file selection patterns, one per line, or `null` to review every changed file."
          }
        },
        "description": "A git repository source of a review."
      },
      "ReviewCountsDto": {
        "required": [
          "files",
          "openThreads",
          "resolvedThreads",
          "checklistItems",
          "checklistAnswered",
          "checklistFailed"
        ],
        "type": "object",
        "properties": {
          "files": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of files in the review.",
            "format": "int32"
          },
          "openThreads": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of comment threads that are open.",
            "format": "int32"
          },
          "resolvedThreads": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of comment threads that are resolved.",
            "format": "int32"
          },
          "checklistItems": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of checklist items that apply to the review.",
            "format": "int32"
          },
          "checklistAnswered": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of applicable checklist items that have an answer.",
            "format": "int32"
          },
          "checklistFailed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of applicable checklist items answered as failed.",
            "format": "int32"
          }
        },
        "description": "The counts that summarize the progress of a review."
      },
      "ReviewDetailDto": {
        "required": [
          "id",
          "title",
          "state",
          "created",
          "contentFingerprint",
          "createdBy",
          "createdViaApi",
          "isFromRepository",
          "repositoryName",
          "baselineSha",
          "headSha",
          "selection",
          "reviewSetId",
          "dueDate",
          "overdue",
          "approved",
          "approvalDigest",
          "slots",
          "counts",
          "blockers",
          "nextStep"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The review identifier, unique within its project."
          },
          "title": {
            "type": "string",
            "description": "The review title."
          },
          "state": {
            "type": "string",
            "description": "The life-cycle state of the review, for example `Draft`."
          },
          "created": {
            "type": "string",
            "description": "When the review was created.",
            "format": "date-time"
          },
          "contentFingerprint": {
            "type": "string",
            "description": "The fingerprint of the reviewed content."
          },
          "createdBy": {
            "type": [
              "null",
              "string"
            ],
            "description": "The user name of the creator, or `null` when it was not recorded."
          },
          "createdViaApi": {
            "type": "boolean",
            "description": "`true` when the review was created with an API token."
          },
          "isFromRepository": {
            "type": "boolean",
            "description": "`true` when the review was created from a git repository, `false` for an upload."
          },
          "repositoryName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name of the registered repository, or `null` for an upload."
          },
          "baselineSha": {
            "type": [
              "null",
              "string"
            ],
            "description": "The baseline commit, or `null` when there is none."
          },
          "headSha": {
            "type": [
              "null",
              "string"
            ],
            "description": "The head commit, or `null` for an upload."
          },
          "selection": {
            "type": [
              "null",
              "string"
            ],
            "description": "The file selection patterns that were used, or `null` when none."
          },
          "reviewSetId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The review-set the review was planned from, or `null`."
          },
          "dueDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The due date as a UTC calendar day in `yyyy-MM-dd` form, or `null` when there is none."
          },
          "overdue": {
            "type": "boolean",
            "description": "`true` when the due date is before today (UTC) and the review is not approved."
          },
          "approved": {
            "type": "boolean",
            "description": "`true` when every reviewer slot has signed the current record and no thread is open."
          },
          "approvalDigest": {
            "type": "string",
            "description": "The digest of the review record as it is now."
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotDto"
            },
            "description": "The reviewer slots in creation order."
          },
          "counts": {
            "description": "The progress counts.",
            "$ref": "#/components/schemas/ReviewCountsDto"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The plain-language reasons the review cannot be signed yet; empty when it can be."
          },
          "nextStep": {
            "type": "string",
            "description": "One short sentence that words what to do next."
          },
          "followsReviewId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The review this one follows up, or `null` when it is not a follow-up."
          },
          "carriedAnswerCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How many checklist answers were carried over from the followed review; 0 when none.",
            "format": "int32",
            "default": 0
          },
          "carriedThreadCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How many open threads were carried over from the followed review; 0 when none.",
            "format": "int32",
            "default": 0
          }
        },
        "description": "A review with its details, approval status and counts."
      },
      "ReviewSummaryDto": {
        "required": [
          "id",
          "title",
          "state",
          "created",
          "contentFingerprint",
          "createdBy",
          "createdViaApi",
          "isFromRepository",
          "dueDate",
          "overdue"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The review identifier, unique within its project."
          },
          "title": {
            "type": "string",
            "description": "The review title."
          },
          "state": {
            "type": "string",
            "description": "The life-cycle state of the review, for example `Draft`."
          },
          "created": {
            "type": "string",
            "description": "When the review was created.",
            "format": "date-time"
          },
          "contentFingerprint": {
            "type": "string",
            "description": "The fingerprint of the reviewed content."
          },
          "createdBy": {
            "type": [
              "null",
              "string"
            ],
            "description": "The user name of the creator, or `null` when it was not recorded."
          },
          "createdViaApi": {
            "type": "boolean",
            "description": "`true` when the review was created with an API token."
          },
          "isFromRepository": {
            "type": "boolean",
            "description": "`true` when the review was created from a git repository, `false` for an upload."
          },
          "dueDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The due date as a UTC calendar day in `yyyy-MM-dd` form, or `null` when there is none."
          },
          "overdue": {
            "type": "boolean",
            "description": "`true` when the due date is before today (UTC) and the review is not approved."
          },
          "followsReviewId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The review this one follows up, or `null` when it is not a follow-up."
          },
          "approved": {
            "type": "boolean",
            "description": "`true` when every reviewer slot holds a current signature and no thread is open (the review is approved and locked).",
            "default": false
          },
          "slotsRequired": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of reviewer slots, each of which must hold a current signature.",
            "format": "int32",
            "default": 0
          },
          "slotsSigned": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of slots that hold a signature of the current record.",
            "format": "int32",
            "default": 0
          },
          "slotsOutOfDate": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of slots whose signatures are all of an earlier record.",
            "format": "int32",
            "default": 0
          },
          "lastActivity": {
            "type": [
              "null",
              "string"
            ],
            "description": "When the review last had an entry in the audit trail; the creation time when it has none.",
            "format": "date-time"
          }
        },
        "description": "A review in a list, without its details."
      },
      "SkippedFileDto": {
        "required": [
          "path",
          "reason"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The path of the entry."
          },
          "reason": {
            "type": "string",
            "description": "Why the entry was skipped."
          }
        },
        "description": "A repository entry that was left out of a review."
      },
      "SlotDto": {
        "required": [
          "id",
          "number",
          "primary",
          "alternate",
          "state",
          "signedBy",
          "signedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The identity of the slot.",
            "format": "int32"
          },
          "number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The position of the slot among the slots of the review, starting at 1.",
            "format": "int32"
          },
          "primary": {
            "type": "string",
            "description": "The user name of the primary reviewer."
          },
          "alternate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The user name of the alternate reviewer, or `null` when the slot has none."
          },
          "state": {
            "type": "string",
            "description": "Whether the slot holds a signature of the current record: `NotSigned`, `Signed` or `OutOfDate`."
          },
          "signedBy": {
            "type": [
              "null",
              "string"
            ],
            "description": "The display name of the signer of the current signature, or `null` when the slot is not signed."
          },
          "signedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "The time of the current signature, or `null` when the slot is not signed.",
