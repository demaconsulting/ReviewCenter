package ReviewCenter {
    private import SoftwareItemMetadata::*;

    part def ApiTokenAuthentication {
        doc /* The authentication scheme and the authorization policies of the API: turns a personal access token, sent as a bearer token or as the password of HTTP Basic credentials, into the principal of its owner (with the system administrator role claim only when the owner is a system administrator), marked as coming through a token, or into one generic 401 refusal (also for an owner who must still change a temporary password, who gets no token access) that also offers the Basic challenge; leaves requests without a token header to the other schemes; ignores the cookie on the API and the token everywhere else; throttles repeated failures per client address with the address limit of the sign-in (429 with Retry-After); and records refused uses in the audit trail without a token value. Also holds the two policies of the evidence index and the attestation PDF, which let a request without any Authorization header through when the project has switched on that route (the evidence settings; a wrong token never falls back to anonymous; every refusal is the same generic 401), and the per-address limit of 30 such requests per minute. */

        metadata info : SoftwareInfo {
            description = "The authentication scheme and the authorization policies of the API: turns a personal access token, sent as a bearer token or as the password of HTTP Basic credentials, into the principal of its owner (with the system administrator role claim only when the owner is a system administrator), marked as coming through a token, or into one generic 401 refusal (also for an owner who must still change a temporary password, who gets no token access) that also offers the Basic challenge; leaves requests without a token header to the other schemes; ignores the cookie on the API and the token everywhere else; throttles repeated failures per client address with the address limit of the sign-in (429 with Retry-After); and records refused uses in the audit trail without a token value. Also holds the two policies of the evidence index and the attestation PDF, which let a request without any Authorization header through when the project has switched on that route (the evidence settings; a wrong token never falls back to anonymous; every refusal is the same generic 401), and the per-address limit of 30 such requests per minute.";
            sourceFiles = ("src/DemaConsulting.ReviewCenter/Api/ApiTokenAuthentication.cs", "src/DemaConsulting.ReviewCenter/Api/AnonymousEvidenceAccess.cs", "src/DemaConsulting.ReviewCenter/Api/AnonymousRateLimit.cs");
            testFiles = ("test/DemaConsulting.ReviewCenter.Tests/Api/ApiTokenAuthenticationTests.cs", "test/DemaConsulting.ReviewCenter.Tests/Api/AnonymousEvidenceAccessTests.cs", "test/DemaConsulting.ReviewCenter.Tests/Api/AnonymousRateLimitTests.cs");
            designFiles = ("docs/design/review-center/api/api-token-authentication.md");
            verificationFiles = ("docs/verification/review-center/api/api-token-authentication.md");
            requirementFiles = ("docs/reqstream/review-center/api/api-token-authentication.yaml");
        }
    }
}
