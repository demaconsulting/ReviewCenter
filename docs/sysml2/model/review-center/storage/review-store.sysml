package ReviewCenter {
    part def ReviewStore {
        doc /* Database implementation of the Core store interface that saves and reads projects (with their evidence settings, which are changed only by an atomic compare-and-set together with its audit entry), project memberships (added, changed, and removed with an audit entry that carries the project, the last enabled project administrator protected atomically on request), reviews (with their source and change kinds), file content and baseline content, comment threads (with the kind of a thread and the kind and report flag of a comment; promotion, demotion, the toggle of a comment, and the resolution with its note, each with its audit entry in the same transaction), checklist snapshots and answers, reviewer slots, and signatures, the reopenings of an approved review (with their audit entry in the same transaction) and the per-project review rules (UpdateReviewRuleAsync: independent reviewers, non-author checklist answers, and non-reopener signing, each an atomic compare-and-set with its audit entry), reads the whole record of a review (including the number of reopenings), changes the optional due date of a review only by an atomic compare-and-set together with its audit entry, changes the optional review conclusion text of a review (part of the record) in the same way and refuses it for a concluded review, refuses a signature of a record that changed, refuses a signature while a thread is open (re-checked inside the signing transaction), and refuses inside the transaction every change of the content, the threads, or the reviewers of a review that is concluded (ReviewLocked). */

        comment sourceRef /* Source: src/DemaConsulting.ReviewCenter/Storage/ReviewStore.cs */
        comment testRef /* Test: test/DemaConsulting.ReviewCenter.Tests/Storage/ReviewStoreTests.cs, ReviewStoreRepositoryTests.cs, ReviewStoreSigningTests.cs, ReviewStoreMembershipTests.cs, ProjectMembersStoreTests.cs, EvidenceSettingsStoreTests.cs, ProjectChecklistStoreTests.cs, ReviewDueDateStoreTests.cs, ReviewFollowUpStoreTests.cs, ReviewStoreReviewConclusionTextTests.cs, and ReviewStoreRecordContentTests.cs */
        comment designRef /* Design: docs/design/review-center/storage/review-store.md */
        comment verificationRef /* Verification: docs/verification/review-center/storage/review-store.md */
        comment reqRef /* Requirements: docs/reqstream/review-center/storage/review-store.yaml */
    }
}
